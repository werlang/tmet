{
  "login": {
    "username": [
      "#id_username",
      "#username",
      "input[name=\"username\"]",
      "input[name=\"login\"]"
    ],
    "password": [
      "#id_password",
      "#password",
      "input[name=\"password\"]",
      "input[type=\"password\"]"
    ],
    "submit": [
      "input[type=\"submit\"]",
      "button[type=\"submit\"]"
    ],
    "postLoginReady": [
      "#user-tools .user-profile",
      "#user-tools",
      ".user-profile",
      "a[href*=\"logout\"]",
      "a[href*=\"/accounts/logout\"]"
    ]
  },
  "session": {
    "invalidWhenPresent": [
      "#id_username",
      "#username",
      "input[name=\"username\"]",
      "input[name=\"login\"]"
    ],
    "expiredMessages": [
      "Sua sessão expirou",
      "faça login novamente",
      "Efetuar login"
    ]
  }
}
